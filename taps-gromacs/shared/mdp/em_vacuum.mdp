; Energy minimization in a large vacuum box (no water)
integrator               = steep
nsteps                   = 50000
emtol                    = 100.0
emstep                   = 0.01
nstlist                  = 10
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
pbc                      = xyz
constraints              = none
